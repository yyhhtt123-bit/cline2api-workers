# 复制成 .env 后填写（.env 已被 .gitignore 忽略，不会进仓库）

# 必填：Cline 账号的 refreshToken，一行一个（多账号 = 额度用尽自动切号）
# 用 `node get-token.js` 获取
CLINE_REFRESH_TOKEN=

# 可选：已有 accessToken 时可直填（与 CLINE_REFRESH_TOKEN 二选一）
# CLINE_ACCESS_TOKEN=

# 可选：客户端访问密钥。不设 = 不鉴权（本地自测方便，公网部署务必设置）
# API_KEY=sk-cline-xxx

# 可选：覆盖默认模型
# DEFAULT_MODEL=cline-cloud/deepseek-v4.1-flash

# 可选：未知模型名是否回落到默认模型（默认 true，让任何客户端都能直接跑）
# FALLBACK_TO_DEFAULT=true

# 可选：低于此值的 max_tokens 会被丢弃（上游对过小值返回 500 empty response content）
# MIN_MAX_TOKENS=100

# 可选：服务端口 / 监听地址
# PORT=8787
# HOST=127.0.0.1
